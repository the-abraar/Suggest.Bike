# Copy to finder/.env (git-ignored) for local runs, or set these as GitHub Actions secrets / Worker secrets.
# Nothing here is a real value.

# --- Safety switches ---
# FINDER_LIVE=1 is the ONLY way real WhatsApp messages are sent. Leave unset for dry runs.
FINDER_LIVE=
# Stop all Bikroy fetching at once.
FINDER_DISABLE_BIKROY=
# Live Bikroy fetching is off until the owner has reviewed their terms of service. See finder/README.md.
FINDER_BIKROY=
FINDER_MAX_MESSAGES=30

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=bike_finder_match
WHATSAPP_TEMPLATE_LANG=en
# Optional Bangla template
WHATSAPP_TEMPLATE_BN=bike_finder_match_bn
WHATSAPP_TEMPLATE_LANG_BN=bn

# --- Store: Cloudflare Worker (leave empty to use finder/data/*.json) ---
FINDER_API=
FINDER_ADMIN_TOKEN=
