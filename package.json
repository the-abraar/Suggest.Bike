{
  "name": "suggest-bike",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-data.mjs && tsx scripts/build-art.tsx",
    "predev": "node scripts/build-data.mjs && tsx scripts/build-art.tsx",
    "dev": "next dev",
    "prebuild": "node scripts/build-data.mjs && tsx scripts/build-art.tsx",
    "build": "next build",
    "preview": "npx --yes serve@14 out -l 3000",
    "pretypecheck": "node scripts/build-data.mjs && tsx scripts/build-art.tsx",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.mjs",
    "finder": "tsx finder/run.ts",
    "finder:test": "tsx finder/test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
