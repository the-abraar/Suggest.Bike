{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suggest.bike/offers.schema.json",
  "title": "Suggest.Bike showroom offers",
  "description": "Time-limited showroom offers, edited by hand. Dates are YYYY-MM-DD (Bangladesh). An offer shows on the site only between startsOn and endsOn; run `npm run validate` after editing.",
  "type": "object",
  "required": ["offers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "offers": { "type": "array", "items": { "$ref": "#/$defs/offer" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
    "offer": {
      "type": "object",
      "required": ["id", "bikeIds", "type", "title", "titleBn", "startsOn", "endsOn", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unique; e.g. <bike-id>-<yyyy-mm>-<type>" },
        "bikeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Bike ids from src/data/bikes.json" },
        "type": { "enum": ["discount", "free-registration", "cashback", "emi", "exchange", "gift", "other"] },
        "title": { "type": "string", "minLength": 5, "description": "Short English headline, e.g. '৳20,000 off until 31 October'" },
        "titleBn": { "type": "string", "minLength": 5, "description": "Same headline in Bangla" },
        "regularPriceBDT": { "type": "integer", "minimum": 20000, "description": "Price before the offer, as the source states it" },
        "offerPriceBDT": { "type": "integer", "minimum": 20000, "description": "Price during the offer; required for a discount, lower than regularPriceBDT" },
        "startsOn": { "$ref": "#/$defs/date" },
        "endsOn": { "$ref": "#/$defs/date", "description": "Last day of the offer (inclusive)" },
        "where": { "type": "string", "description": "Which showrooms; omit if unknown" },
        "source": {
          "type": "object",
          "required": ["name", "url"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "url": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "type": { "const": "discount" } } },
      "then": { "required": ["regularPriceBDT", "offerPriceBDT"] }
    }
  }
}
